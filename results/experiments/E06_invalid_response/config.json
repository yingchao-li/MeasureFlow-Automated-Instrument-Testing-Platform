{
  "experiment": "E06",
  "slug": "invalid_response",
  "base_seed": 12345,
  "quick_mode": false,
  "sequence": "gain_verification",
  "analyzer_max_retries": 0,
  "analyzer_timeout_ms": 300,
  "task_retries": 0,
  "repeats": 5,
  "cases": [
    {
      "name": "garbage",
      "inject": "MF:FAULT:GARBAGE 1",
      "expect": [
        "ERROR",
        "{'COMM_INVALID_RESPONSE'}"
      ]
    },
    {
      "name": "nan",
      "inject": "MF:FAULT:NAN 1",
      "expect": [
        "ERROR",
        "{'MEASUREMENT_NAN'}"
      ]
    },
    {
      "name": "inf",
      "inject": "MF:FAULT:INF 1",
      "expect": [
        "ERROR",
        "{'MEASUREMENT_INF'}"
      ]
    },
    {
      "name": "oversize",
      "inject": "MF:FAULT:OVERSIZE 1",
      "expect": [
        "ERROR",
        "{'COMM_RESPONSE_TOO_LARGE'}"
      ]
    },
    {
      "name": "fragment",
      "inject": "MF:FAULT:FRAGMENT 1",
      "expect": [
        "PASS",
        "{None}"
      ]
    },
    {
      "name": "empty_line",
      "inject": null,
      "replace": "\n",
      "expect": [
        "ERROR",
        "{'COMM_INVALID_RESPONSE'}"
      ]
    },
    {
      "name": "truncated",
      "inject": null,
      "replace": "19.9",
      "expect": [
        "ERROR",
        "{'COMM_TIMEOUT'}"
      ]
    },
    {
      "name": "dut_nan_samples",
      "inject": "MF:DUT:FAULT NAN",
      "target": "dut",
      "match": "^MF:ACQ:INIT",
      "expect": [
        "ERROR",
        "{'MEASUREMENT_NAN'}"
      ]
    },
    {
      "name": "dut_inf_samples",
      "inject": "MF:DUT:FAULT INF",
      "target": "dut",
      "match": "^MF:ACQ:INIT",
      "expect": [
        "ERROR",
        "{'MEASUREMENT_NAN', 'MEASUREMENT_INF'}"
      ]
    }
  ],
  "versions": {
    "python": "3.13.18",
    "platform": "Linux-6.18.44-fc-v470-x86_64-with-glibc2.39",
    "backend": "0.1.0",
    "simulator_reported_by_backend": "0.1.0",
    "config_version": "1.0.0",
    "simulator": "0.1.0"
  }
}
