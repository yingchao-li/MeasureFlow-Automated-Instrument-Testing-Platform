{
  "id": "gain_verification",
  "name": "Gain Verification",
  "version": "1.0.0",
  "description": "Verifies the DUT gain at a single stimulus frequency against a tolerance window.",
  "dut": {
    "profile": "NORMAL",
    "firmware": "1.0.0"
  },
  "parameters": {
    "frequency_hz": {
      "label": "Stimulus frequency",
      "unit": "Hz",
      "default": 1000,
      "min": 20,
      "max": 20000
    },
    "amplitude_vpk": {
      "label": "Stimulus amplitude",
      "unit": "Vpk",
      "default": 0.05,
      "min": 0.001,
      "max": 1.0
    },
    "gain_min_db": {
      "label": "Gain lower limit",
      "unit": "dB",
      "default": 19.0,
      "min": -20,
      "max": 60
    },
    "gain_max_db": {
      "label": "Gain upper limit",
      "unit": "dB",
      "default": 21.0,
      "min": -20,
      "max": 60
    }
  },
  "steps": [
    {
      "id": "init",
      "type": "init",
      "name": "Initialize instruments",
      "instruments": [
        "siggen",
        "analyzer",
        "dut"
      ]
    },
    {
      "id": "cfg_signal",
      "type": "configure_signal",
      "name": "Configure stimulus",
      "function": "SIN",
      "frequency_hz": "${frequency_hz}",
      "amplitude_vpk": "${amplitude_vpk}",
      "sample_rate_hz": 48000,
      "output": true,
      "settle_ms": 10
    },
    {
      "id": "cfg_dut",
      "type": "configure_dut",
      "name": "Configure device under test",
      "settings": {}
    },
    {
      "id": "gain",
      "type": "measure",
      "name": "Gain @ ${frequency_hz} Hz",
      "measurement": "gain",
      "limits": {
        "min": "${gain_min_db}",
        "max": "${gain_max_db}",
        "unit": "dB"
      }
    },
    {
      "id": "cleanup",
      "type": "cleanup",
      "name": "Cleanup instruments"
    },
    {
      "id": "report",
      "type": "report",
      "name": "Generate report"
    }
  ]
}
