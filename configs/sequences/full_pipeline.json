{
  "id": "full_pipeline",
  "name": "Full Pipeline",
  "version": "1.0.0",
  "description": "End-to-end characterisation: RMS, gain, THD, SNR, noise floor and a frequency sweep.",
  "dut": {
    "profile": "NORMAL",
    "firmware": "1.0.0"
  },
  "parameters": {
    "frequency_hz": {
      "label": "Stimulus frequency",
      "unit": "Hz",
      "default": 1000,
      "min": 20,
      "max": 20000
    },
    "amplitude_vpk": {
      "label": "Stimulus amplitude",
      "unit": "Vpk",
      "default": 0.05,
      "min": 0.001,
      "max": 1.0
    },
    "rms_min_v": {
      "label": "RMS lower limit",
      "unit": "V",
      "default": 0.318,
      "min": 0,
      "max": 10
    },
    "rms_max_v": {
      "label": "RMS upper limit",
      "unit": "V",
      "default": 0.389,
      "min": 0,
      "max": 10
    },
    "gain_min_db": {
      "label": "Gain lower limit",
      "unit": "dB",
      "default": 19.0,
      "min": -20,
      "max": 60
    },
    "gain_max_db": {
      "label": "Gain upper limit",
      "unit": "dB",
      "default": 21.0,
      "min": -20,
      "max": 60
    },
    "thd_max_percent": {
      "label": "THD upper limit",
      "unit": "%",
      "default": 1.0,
      "min": 0.0,
      "max": 100
    },
    "snr_min_db": {
      "label": "SNR lower limit",
      "unit": "dB",
      "default": 60.0,
      "min": 0,
      "max": 140
    },
    "noise_max_dbv": {
      "label": "Noise floor upper limit",
      "unit": "dBV",
      "default": -70.0,
      "min": -140,
      "max": 0
    },
    "sweep_min_db": {
      "label": "Sweep gain lower limit",
      "unit": "dB",
      "default": 16.0,
      "min": -20,
      "max": 60
    },
    "sweep_max_db": {
      "label": "Sweep gain upper limit",
      "unit": "dB",
      "default": 21.5,
      "min": -20,
      "max": 60
    }
  },
  "steps": [
    {
      "id": "init",
      "type": "init",
      "name": "Initialize instruments",
      "instruments": [
        "siggen",
        "analyzer",
        "dut"
      ]
    },
    {
      "id": "cfg_signal",
      "type": "configure_signal",
      "name": "Configure stimulus",
      "function": "SIN",
      "frequency_hz": "${frequency_hz}",
      "amplitude_vpk": "${amplitude_vpk}",
      "sample_rate_hz": 48000,
      "output": true,
      "settle_ms": 10
    },
    {
      "id": "cfg_dut",
      "type": "configure_dut",
      "name": "Configure device under test",
      "settings": {}
    },
    {
      "id": "rms",
      "type": "measure",
      "name": "RMS @ ${frequency_hz} Hz",
      "measurement": "rms",
      "limits": {
        "min": "${rms_min_v}",
        "max": "${rms_max_v}",
        "unit": "V"
      }
    },
    {
      "id": "gain",
      "type": "measure",
      "name": "Gain @ ${frequency_hz} Hz",
      "measurement": "gain",
      "limits": {
        "min": "${gain_min_db}",
        "max": "${gain_max_db}",
        "unit": "dB"
      }
    },
    {
      "id": "thd",
      "type": "measure",
      "name": "THD @ ${frequency_hz} Hz",
      "measurement": "thd",
      "limits": {
        "min": null,
        "max": "${thd_max_percent}",
        "unit": "%"
      }
    },
    {
      "id": "snr",
      "type": "measure",
      "name": "SNR @ ${frequency_hz} Hz",
      "measurement": "snr",
      "limits": {
        "min": "${snr_min_db}",
        "max": null,
        "unit": "dB"
      }
    },
    {
      "id": "noise_floor",
      "type": "measure",
      "name": "Noise floor",
      "measurement": "noise_floor",
      "limits": {
        "min": null,
        "max": "${noise_max_dbv}",
        "unit": "dBV"
      }
    },
    {
      "id": "sweep",
      "type": "sweep",
      "name": "Gain sweep",
      "measurement": "gain",
      "points_hz": [
        100,
        200,
        500,
        1000,
        2000,
        4000,
        6000,
        8000
      ],
      "amplitude_vpk": "${amplitude_vpk}",
      "limits": {
        "min": "${sweep_min_db}",
        "max": "${sweep_max_db}",
        "unit": "dB"
      }
    },
    {
      "id": "cleanup",
      "type": "cleanup",
      "name": "Cleanup instruments"
    },
    {
      "id": "report",
      "type": "report",
      "name": "Generate report"
    }
  ]
}
