{
  "id": "rms_measurement",
  "name": "RMS Measurement",
  "version": "1.0.0",
  "description": "Measures the RMS output voltage of the DUT.",
  "dut": {
    "profile": "NORMAL",
    "firmware": "1.0.0"
  },
  "parameters": {
    "frequency_hz": {
      "label": "Stimulus frequency",
      "unit": "Hz",
      "default": 1000,
      "min": 20,
      "max": 20000
    },
    "amplitude_vpk": {
      "label": "Stimulus amplitude",
      "unit": "Vpk",
      "default": 0.05,
      "min": 0.001,
      "max": 1.0
    },
    "rms_min_v": {
      "label": "RMS lower limit",
      "unit": "V",
      "default": 0.318,
      "min": 0,
      "max": 10
    },
    "rms_max_v": {
      "label": "RMS upper limit",
      "unit": "V",
      "default": 0.389,
      "min": 0,
      "max": 10
    }
  },
  "steps": [
    {
      "id": "init",
      "type": "init",
      "name": "Initialize instruments",
      "instruments": [
        "siggen",
        "analyzer",
        "dut"
      ]
    },
    {
      "id": "cfg_signal",
      "type": "configure_signal",
      "name": "Configure stimulus",
      "function": "SIN",
      "frequency_hz": "${frequency_hz}",
      "amplitude_vpk": "${amplitude_vpk}",
      "sample_rate_hz": 48000,
      "output": true,
      "settle_ms": 10
    },
    {
      "id": "cfg_dut",
      "type": "configure_dut",
      "name": "Configure device under test",
      "settings": {}
    },
    {
      "id": "rms",
      "type": "measure",
      "name": "RMS @ ${frequency_hz} Hz",
      "measurement": "rms",
      "limits": {
        "min": "${rms_min_v}",
        "max": "${rms_max_v}",
        "unit": "V"
      }
    },
    {
      "id": "cleanup",
      "type": "cleanup",
      "name": "Cleanup instruments"
    },
    {
      "id": "report",
      "type": "report",
      "name": "Generate report"
    }
  ]
}
