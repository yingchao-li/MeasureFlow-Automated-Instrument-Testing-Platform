{
  "id": "frequency_sweep",
  "name": "Frequency Sweep",
  "version": "1.0.0",
  "description": "Sweeps the stimulus over the hearing-aid band and checks the gain at every point.",
  "dut": {
    "profile": "NORMAL",
    "firmware": "1.0.0"
  },
  "parameters": {
    "frequency_hz": {
      "label": "Stimulus frequency",
      "unit": "Hz",
      "default": 1000,
      "min": 20,
      "max": 20000
    },
    "amplitude_vpk": {
      "label": "Stimulus amplitude",
      "unit": "Vpk",
      "default": 0.05,
      "min": 0.001,
      "max": 1.0
    },
    "sweep_min_db": {
      "label": "Sweep gain lower limit",
      "unit": "dB",
      "default": 16.0,
      "min": -20,
      "max": 60
    },
    "sweep_max_db": {
      "label": "Sweep gain upper limit",
      "unit": "dB",
      "default": 21.5,
      "min": -20,
      "max": 60
    }
  },
  "steps": [
    {
      "id": "init",
      "type": "init",
      "name": "Initialize instruments",
      "instruments": [
        "siggen",
        "analyzer",
        "dut"
      ]
    },
    {
      "id": "cfg_signal",
      "type": "configure_signal",
      "name": "Configure stimulus",
      "function": "SIN",
      "frequency_hz": "${frequency_hz}",
      "amplitude_vpk": "${amplitude_vpk}",
      "sample_rate_hz": 48000,
      "output": true,
      "settle_ms": 10
    },
    {
      "id": "cfg_dut",
      "type": "configure_dut",
      "name": "Configure device under test",
      "settings": {}
    },
    {
      "id": "sweep",
      "type": "sweep",
      "name": "Gain sweep",
      "measurement": "gain",
      "points_hz": [
        100,
        200,
        500,
        1000,
        2000,
        4000,
        6000,
        8000
      ],
      "amplitude_vpk": "${amplitude_vpk}",
      "limits": {
        "min": "${sweep_min_db}",
        "max": "${sweep_max_db}",
        "unit": "dB"
      }
    },
    {
      "id": "cleanup",
      "type": "cleanup",
      "name": "Cleanup instruments"
    },
    {
      "id": "report",
      "type": "report",
      "name": "Generate report"
    }
  ]
}
