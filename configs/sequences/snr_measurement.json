{
  "id": "snr_measurement",
  "name": "SNR Measurement",
  "version": "1.0.0",
  "description": "Measures the in-band signal-to-noise ratio of the DUT output.",
  "dut": {
    "profile": "NORMAL",
    "firmware": "1.0.0"
  },
  "parameters": {
    "frequency_hz": {
      "label": "Stimulus frequency",
      "unit": "Hz",
      "default": 1000,
      "min": 20,
      "max": 20000
    },
    "amplitude_vpk": {
      "label": "Stimulus amplitude",
      "unit": "Vpk",
      "default": 0.05,
      "min": 0.001,
      "max": 1.0
    },
    "snr_min_db": {
      "label": "SNR lower limit",
      "unit": "dB",
      "default": 60.0,
      "min": 0,
      "max": 140
    }
  },
  "steps": [
    {
      "id": "init",
      "type": "init",
      "name": "Initialize instruments",
      "instruments": [
        "siggen",
        "analyzer",
        "dut"
      ]
    },
    {
      "id": "cfg_signal",
      "type": "configure_signal",
      "name": "Configure stimulus",
      "function": "SIN",
      "frequency_hz": "${frequency_hz}",
      "amplitude_vpk": "${amplitude_vpk}",
      "sample_rate_hz": 48000,
      "output": true,
      "settle_ms": 10
    },
    {
      "id": "cfg_dut",
      "type": "configure_dut",
      "name": "Configure device under test",
      "settings": {}
    },
    {
      "id": "snr",
      "type": "measure",
      "name": "SNR @ ${frequency_hz} Hz",
      "measurement": "snr",
      "limits": {
        "min": "${snr_min_db}",
        "max": null,
        "unit": "dB"
      }
    },
    {
      "id": "cleanup",
      "type": "cleanup",
      "name": "Cleanup instruments"
    },
    {
      "id": "report",
      "type": "report",
      "name": "Generate report"
    }
  ]
}
